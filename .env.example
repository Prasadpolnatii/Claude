# Copy to .env and fill in values. Node auto-loads via dotenv in the API.

# ── LLM ───────────────────────────────────────────────────────────
# Leave LLM_MODE=mock to run the full flow with NO OpenAI key and NO spend.
# Set LLM_MODE=openai + a real key to use the live API.
LLM_MODE=mock
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL_SMALL=gpt-4o-mini
OPENAI_CHAT_MODEL_LARGE=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Data stores ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ops_copilot
# Atlas Vector Search index name (created out-of-band on the `sops` collection).
VECTOR_INDEX_NAME=sop_vector_index
REDIS_URL=redis://localhost:6379

# ── Auth (multi-tenant) ───────────────────────────────────────────
JWT_SECRET=change-me-in-prod-please-use-32-bytes-min
JWT_ISSUER=ops-copilot

# ── Server ────────────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# ── Budget guardrails (per tenant, per day) ───────────────────────
TENANT_DAILY_TOKEN_BUDGET=2000000

# ── Dashboard: real-time alert demo ───────────────────────────────
# When true, the API synthesizes monitoring alerts for ALERTS_SIMULATE_TENANT so
# the dashboard's live alert feed is populated without a real monitoring
# pipeline. Set false in production and push alerts to the bus from a webhook.
ALERTS_SIMULATE=true
ALERTS_SIMULATE_TENANT=demo-tenant
ALERTS_SIMULATE_INTERVAL_MS=20000
